{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.studioform.app; connect-src 'self' https://www.studioform.app http://localhost:5000;"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/:slug",
      "destination": "/ai-news/:slug",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "studioform.app"
        }
      ],
      "destination": "https://www.studioform.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/b2b-marketing-email",
      "destination": "/b2b-marketing-email.html"
    },
    {
      "source": "/b2b-marketing-email.html",
      "destination": "/b2b-marketing-email.html"
    },
    {
      "source": "/blueprint-template",
      "destination": "/blueprint-template.html"
    },
    {
      "source": "/blueprint-template.html",
      "destination": "/blueprint-template.html"
    },
    {
      "source": "/chatbots-template",
      "destination": "/chatbots-template.html"
    },
    {
      "source": "/chatbots-template.html",
      "destination": "/chatbots-template.html"
    },
    {
      "source": "/voice-agents-template",
      "destination": "/voice-agents-template.html"
    },
    {
      "source": "/voice-agents-template.html",
      "destination": "/voice-agents-template.html"
    },
    {
      "source": "/email-template",
      "destination": "/email-template.html"
    },
    {
      "source": "/email-template.html",
      "destination": "/email-template.html"
    },
    {
      "source": "/(static|images|logo_dark.png|og-image.png|email_hero_blue.png|favicon.ico|favicon-32x32.png|favicon-48x48.png|icon-192.png|icon-512.png|apple-touch-icon.png|manifest.json|robots.txt|sitemap.xml|rss.xml|llms.txt)(.*)",
      "destination": "/$1$2"
    },
    {
      "source": "/(pricing|about|team|contact|ai-news|docs|changelog|privacy|terms|refund|shipping|cancellation|workshops|ai-university|case-studies|twilio-alternatives|blog-admin|admin|blog)",
      "destination": "/$1/index.html"
    },
    {
      "source": "/(services|industries|case-studies|resources|ai-news)/:slug",
      "destination": "/$1/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
